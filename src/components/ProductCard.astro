---
import { Image } from 'astro:assets';
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const LOGO_SIZE = 56;
const SCREENSHOT_WIDTH = 480;
const HIGH_DENSITY = 2;
---
<article class="card" style={`--logo-size: ${LOGO_SIZE}px`}>
  <div class="head">
    {product.logo ? (
      <Image src={product.logo} alt="" width={LOGO_SIZE} height={LOGO_SIZE} class="logo" />
    ) : (
      <span class="logo monogram" aria-hidden="true">{product.name.charAt(0).toUpperCase()}</span>
    )}
    <div>
      <h3>{product.name}</h3>
      {product.tagline && <p class="tagline">{product.tagline}</p>}
    </div>
  </div>

  {product.screenshot && (
    <Image
      src={product.screenshot}
      alt={`${product.name} の画面`}
      widths={[SCREENSHOT_WIDTH, SCREENSHOT_WIDTH * HIGH_DENSITY]}
      sizes={`(max-width: 800px) 100vw, ${SCREENSHOT_WIDTH}px`}
      class="screenshot"
    />
  )}

  {product.summary ? <p class="summary">{product.summary}</p> : <p class="summary pending">詳細は準備中です。</p>}

  <div class="foot">
    {product.url ? (
      <a href={product.url} target="_blank" rel="noopener noreferrer" aria-label={`${product.name} のサイトを見る`}>
        サイトを見る
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M6 3h7v7M13 3 4 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    ) : (
      <span class="badge">準備中</span>
    )}
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 24px;
    height: 100%;
    padding: clamp(28px, 3vw, 40px);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    transition:
      box-shadow 0.3s ease,
      transform 0.3s var(--ease-out),
      border-color 0.3s ease;
  }

  .card:has(a:hover) {
    border-color: transparent;
    box-shadow: var(--shadow-lift);
    transform: translateY(-4px);
  }

  .head {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .logo {
    flex: none;
    width: var(--logo-size);
    height: var(--logo-size);
    border-radius: 14px;
  }

  .monogram {
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--color-blue);
    background: var(--color-blue-tint);
  }

  h3 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0.04em;
    line-height: 1.3;
  }

  .tagline {
    margin-top: 4px;
    word-break: auto-phrase;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .screenshot {
    width: 100%;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-line);
  }

  .summary {
    flex: 1;
    font-size: 0.9375rem;
    color: var(--color-text-sub);
  }

  .pending {
    color: var(--color-text-muted);
  }

  .foot {
    padding-top: 20px;
    border-top: 1px solid var(--color-line);
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }

  /* カード内に操作できる要素がリンク 1 つだけなので、カード全体をリンクの押せる範囲に広げる */
  a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  svg {
    width: 14px;
    height: 14px;
  }

  .badge {
    display: inline-block;
    padding: 2px 12px;
    border-radius: 999px;
    background: var(--color-bg-soft);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }

    .card:has(a:hover) {
      transform: none;
    }
  }
</style>
