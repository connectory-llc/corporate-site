---
import { COPYRIGHT, NAV_ITEMS } from '../data/site';
import { withBase } from '../lib/url';
import Logo from './Logo.astro';
---
<footer class="site-footer">
  <div class="container inner">
    <div class="brand">
      <Logo tone="inverse" />
      <p class="tagline">CONNECT × FACTORY</p>
    </div>
    <nav aria-label="フッター">
      <ul>
        {NAV_ITEMS.map((item) => (
          <li><a href={withBase(item.href)}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="container">
    <p class="copyright"><small>{COPYRIGHT}</small></p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 64px 32px;
    background: var(--color-ink);
    color: var(--color-on-ink-sub);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
    padding-bottom: 40px;
    border-bottom: 1px solid rgb(255 255 255 / 10%);
  }

  .tagline {
    margin-top: 12px;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.2em;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    font-family: var(--font-display);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    color: var(--color-on-ink-sub);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-on-ink);
  }

  .copyright {
    padding-top: 24px;
    font-family: var(--font-display);
    letter-spacing: 0.08em;
  }
</style>
