---
import { NAV_ITEMS } from '../data/site';
import { withBase } from '../lib/url';
import Logo from './Logo.astro';
---
<header class="site-header">
  <div class="container inner">
    <a href={withBase('/')} class="home" aria-label="CONNECTORY トップへ">
      <Logo />
    </a>
    <nav aria-label="ページ内のセクション">
      <ul>
        {NAV_ITEMS.map((item) => (
          <li><a href={withBase(item.href)}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 78%);
    backdrop-filter: saturate(180%) blur(16px);
    border-bottom: 1px solid rgb(226 232 239 / 70%);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: var(--header-height);
  }

  .home {
    display: inline-flex;
    text-decoration: none;
  }

  ul {
    display: flex;
    gap: clamp(20px, 3vw, 40px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    position: relative;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-text-sub);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    border-radius: 2px;
    background: var(--gradient-brand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out);
  }

  nav a:hover {
    color: var(--color-text);
  }

  nav a:hover::after {
    transform: scaleX(1);
  }

  /* メニューを開閉するスクリプトを持たないよう、狭い画面では導線をロゴの下に 1 行で並べる */
  @media (max-width: 640px) {
    .inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      padding-block: 14px 10px;
    }

    ul {
      gap: 22px;
    }

    nav a {
      font-size: 0.8125rem;
    }
  }
</style>
