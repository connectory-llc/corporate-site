---
import SectionHeading from '../SectionHeading.astro';

const VALUES = [
  { name: '創造', english: 'Create', description: '自由な発想と好奇心を大切にし、さまざまなアイデアを形にする。' },
  { name: '挑戦', english: 'Challenge', description: '失敗を恐れず、新しい技術やアイデアを試し続ける。' },
  { name: '接続', english: 'Connect', description: '技術や制作物を通じて、人と人、想いと価値をつなぐ。' },
  {
    name: '思いやり',
    english: 'Care',
    description: '自分たちの作りたいものを作るだけでなく、利用者の立場に立って考える。',
  },
  {
    name: '品質',
    english: 'Craftsmanship',
    description: '自由な創作を楽しみながらも、公開する制作物には責任を持ち、丁寧に磨き上げる。',
  },
];
const NUMBER_DIGITS = 2;
---
<section id="values" class="values" aria-labelledby="values-title">
  <div class="container inner">
    <div class="heading" data-reveal>
      <SectionHeading id="values-title" eyebrow="Values" title="大切にしている価値観" />
    </div>

    <ol>
      {VALUES.map((value, index) => (
        <li data-reveal>
          <span class="number" aria-hidden="true">{String(index + 1).padStart(NUMBER_DIGITS, '0')}</span>
          <h3>
            <span class="name">{value.name}</span>
            <span class="english">{value.english}</span>
          </h3>
          <p>{value.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .values {
    padding-block: var(--section-space);
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(40px, 6vw, 96px);
  }

  .heading {
    align-self: start;
    position: sticky;
    top: calc(var(--header-height) + 48px);
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 3.5em minmax(0, 12em) minmax(0, 1fr);
    align-items: baseline;
    gap: 8px 24px;
    padding-block: 32px;
    border-top: 1px solid var(--color-line);
  }

  li:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .number {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    background: var(--gradient-brand);
    background-clip: text;
    color: transparent;
  }

  h3 {
    display: grid;
    gap: 2px;
  }

  .name {
    font-size: 1.375rem;
  }

  .english {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    color: var(--color-text-muted);
  }

  p {
    color: var(--color-text-sub);
  }

  @media (max-width: 800px) {
    .inner {
      grid-template-columns: 1fr;
    }

    .heading {
      position: static;
    }
  }

  @media (max-width: 560px) {
    li {
      grid-template-columns: 3em minmax(0, 1fr);
    }

    p {
      grid-column: 2;
    }
  }
</style>
